# Environment
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET_KEY=your-jwt-secret-key

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_AES_KEY=
GOOGLE_ERROR_PERMISSION_URL=

# MongoDB
MONGO_USER=
MONGO_PASS=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=hrm

# SAP SQL Server
SAP_ENDPOINT=
SAP_DB_HOST=
SAP_DB_USER=
SAP_DB_PASS=
SAP_DB_PORT=1433
SAP_DB_LIST=HBCCORP,KBI

# Application
HOST_URL=http://localhost:3000
APP_MANAGER_API_HOST=https://app-manager-api.example.com

# Logging
LOG_LEVEL=DEBUG
